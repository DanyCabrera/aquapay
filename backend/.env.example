PORT=4100
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4100

# Neon — Connection string (pooler recomendado)
# Settings → Connection details → Connection string (URI)
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Auth local (JWT HS256). Genere un secreto largo y aleatorio.
JWT_SECRET=cambie-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# PDFs en disco local (relativo al cwd del backend, o ruta absoluta)
STORAGE_DIR=uploads/recibos

# Opcional: certificado P12 para firma digital de PDF
PDF_SIGN_P12_PATH=
PDF_SIGN_P12_PASSWORD=
